{
  "name": "ethswarm-volume-keeper",
  "version": "0.1.0",
  "description": "viem actions for Swarm Volume Registries — read what needs topping up, and top it up",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "keywords": ["swarm", "ethswarm", "postage-stamp", "keeper", "bzz", "viem", "viem-actions"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.3",
    "viem": "^2.21.0"
  }
}
